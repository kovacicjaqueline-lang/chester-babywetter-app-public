{
  "name": "chester-babywetter-app-public",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8788",
    "test": "node --test",
    "test:browser": "playwright test",
    "test:repository-guard": "node --test test/repository-guard.test.js",
    "guard:pre-push": "node tools/repository-guard.mjs check",
    "workflow:finalize": "node tools/repository-guard.mjs lock",
    "workflow:repair": "node tools/repository-guard.mjs unlock --repair",
    "verify:deploy": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "wrangler": "4.125.0"
  }
}
